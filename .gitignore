experiments/storage-audit-fht/crash/
experiments/storage-audit-fht/gittest/
adapters/bin/lychee

# 本地 TTS：worker venv + 上游 clone（weights 走 HF cache，均不进 git）
venvs/
tools/tts_workers/breeze-tts/

# remotion 手工路径的本机 symlink（指向 gitignored 生成目录，跨机必悬空）
composer/ffmpeg-baseline/
composer/public/audio
composer/public/frames_v2
experiments/remotion-feas/ffmpeg-baseline/
experiments/remotion-feas/public/audio
experiments/remotion-feas/public/frames_v2
experiments/bloomberglaw-feed-probe/node_modules

# repro 生成产物（代码/数据保留，渲染/audio/字体出库）
repro/audio/
repro/chrome/
repro/frames_v2/
repro/subs/
repro/shots/
# assets 内容出库但目录本体不排——否则内层豁免不生效（git 不重入被排目录）
repro/assets/*
