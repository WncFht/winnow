# secrets / runtime state
secrets.env
# 凭据兜底：env/key/pem/cookies/netrc 一律不入库（*.env.example 模板除外）。
# 已跟踪的历史 probe 档案（experiments/*/cookies.txt、cacert.pem 等）不受
# 影响——ignore 只管 untracked；确需新增请 git add -f 显式放行。
.env
*.env
!*.env.example
*.key
*.pem
.netrc
cookies*.txt
# 本地覆盖（engine 切换等）；模板走 config.example.yaml
config.yaml
state/
data/
runs/
# …但 artifact-contracts 的 golden run 是 selftest fixture（测试资产）。
# 注意 git 不重入被排目录：豁免须连 runs/ 目录本体一起否定。
!experiments/artifact-contracts/runs/
.claude/
.vscode/

# python / node
node_modules/
__pycache__/
*.pyc
.DS_Store
repro-venv/

# composer build
composer/node_modules/
composer/out/
composer/.remotion/
composer/.tmp/
composer/smoke/
/out/

# experiment scratch / logs
experiments/card-density/probe_vendor_selfhost/
experiments/orchestration-sched/server.log
experiments/orchestration-sched/prefect.db
experiments/**/.venv*/

# HF/model downloader lock 噪音（非代码）
**/.lock/

# vendored upstream build artifacts + parked gitdir
upstream/juya-news-card/node_modules/
upstream/juya-news-card/.next/
upstream/juya-news-card/dist/
upstream/juya-news-card/out/
upstream/juya-news-card.gitdir/

# MPE preview env (local link farm — scripts/crossnote-links.sh)
/.crossnote/

# 权重/生成物出库（2026-09-23）：模型一律走 HF/下载脚本，不进 git
experiments/**/*.safetensors
experiments/**/*.pt
experiments/**/*.ckpt
experiments/**/*.bin
# …但探测证据 .bin 是调研档案（hard-*/probe 产物），不入"权重"豁免
!experiments/**/body_*.bin
!experiments/**/probe_*.bin
!experiments/**/resp_*.bin
!experiments/tr-com-feed-probe/*.bin
experiments/**/*.mp4
experiments/**/*.mkv
experiments/**/*.wav
experiments/**/*.zip
experiments/**/*.tar.gz
experiments/**/*.onnx
experiments/**/*.so
experiments/**/*.so.*
experiments/**/*.ttf
experiments/**/tmp/
