{
  "$defs": {
    "IssueCard": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "2-7 chars; maps to GeneratedContent.cards[].title",
          "title": "Label",
          "type": "string"
        },
        "body": {
          "description": "30-60 chars, inline-markdown subset; maps to GeneratedContent.cards[].desc after md->html-inline conversion",
          "title": "Body",
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Material Symbols name, snake_case; falls back to 'article' in renderer",
          "title": "Icon"
        }
      },
      "required": [
        "label",
        "body"
      ],
      "title": "IssueCard",
      "type": "object"
    },
    "IssueItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "stable slug; EVERY downstream artifact keys on this (cards, voice files, frames, timeline, dedup history)",
          "pattern": "^[a-z0-9-]{2,24}$",
          "title": "Id",
          "type": "string"
        },
        "item_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sha256(url_canon)[:16] 机械身份——digest 从 kept 注入；落档后与 slug 并存，history 回写/溯源直接 join，不再经 sources.url 反查",
          "title": "Item Key"
        },
        "section": {
          "description": "must equal a slug declared in issue.sections",
          "title": "Section",
          "type": "string"
        },
        "nav": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "short label for video nav bar / breadcrumb / overview list",
          "title": "Nav"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "title_short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional shorter card title for GeneratedContent.mainTitle; renderer falls back to headline",
          "title": "Title Short"
        },
        "tldr": {
          "description": "1-2 dense sentences; renders as the blockquote lead",
          "title": "Tldr",
          "type": "string"
        },
        "body": {
          "description": "paragraphs, inline-markdown subset; the written-text spine of the item",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Body",
          "type": "array"
        },
        "sources": {
          "description": "SHOULD have >=1; empty is legal (e.g. deleted source post — real case: 2026-09-20 #14 kimi) but the validator warns",
          "items": {
            "$ref": "#/$defs/IssueSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "media": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/IssueMedia"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media"
        },
        "confidence": {
          "description": "official fact vs media report vs leak/speculation; enforces the hedging rule in renders and lets video style differ",
          "enum": [
            "confirmed",
            "reported",
            "rumor",
            "speculation"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "entities": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional proper-noun list (models, companies, people); used by dedup/clustering and the no-new-entities validator",
          "title": "Entities"
        },
        "facts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "optional claim whitelist: precise fragments the editor stands behind (e.g. '42.5万例增强腹部CT', '总参数29B 激活4B'). voice/cards may use numbers from headline+tldr+body+facts; anything else is flagged. This is the deterministic anti-hallucination hook for downstream LLM stages.",
          "title": "Facts"
        },
        "voice": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PROJECTION, filled by the voice-script stage; one entry = one TTS sentence; plain text only",
          "title": "Voice"
        },
        "cards": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/IssueCard"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PROJECTION, filled by the card stage; contract-compatible with juya-news-card GeneratedContent",
          "title": "Cards"
        },
        "video": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueVideo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "section",
        "headline",
        "tldr",
        "body",
        "sources",
        "confidence"
      ],
      "title": "IssueItem",
      "type": "object"
    },
    "IssueMedia": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "image",
            "gif",
            "shot",
            "cover"
          ],
          "title": "Kind",
          "type": "string"
        },
        "src": {
          "description": "local/mirrored path or absolute URL",
          "title": "Src",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where the asset came from (source page)",
          "format": "uri",
          "title": "Origin"
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        }
      },
      "required": [
        "kind",
        "src"
      ],
      "title": "IssueMedia",
      "type": "object"
    },
    "IssueSection": {
      "additionalProperties": false,
      "properties": {
        "slug": {
          "pattern": "^[a-z0-9-]{2,24}$",
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        }
      },
      "required": [
        "slug",
        "name"
      ],
      "title": "IssueSection",
      "type": "object"
    },
    "IssueSegment": {
      "additionalProperties": false,
      "properties": {
        "voice": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voice"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "IssueSegment",
      "type": "object"
    },
    "IssueSource": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "title": "Url",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "official",
                "repo",
                "paper",
                "media",
                "social",
                "community",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "drives link-check + screenshot policy: e.g. social/x.com unreachable from CN network -> skip shot or use mirror",
          "title": "Kind"
        },
        "primary": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "exactly one primary source per item; drives the 相关链接 lead link and the default screenshot target",
          "title": "Primary"
        },
        "reachable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "set by the fetch/link-check stage; renderers may warn or drop unreachable sources",
          "title": "Reachable"
        }
      },
      "required": [
        "url"
      ],
      "title": "IssueSource",
      "type": "object"
    },
    "IssueVideo": {
      "additionalProperties": false,
      "properties": {
        "shot_sentences": {
          "anyOf": [
            {
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based indexes into voice[] during which the source-page screenshot overlay shows; production hint filled at video-plan stage",
          "title": "Shot Sentences"
        }
      },
      "title": "IssueVideo",
      "type": "object"
    },
    "IssueVideoLinks": {
      "additionalProperties": false,
      "properties": {
        "bilibili": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uri",
          "title": "Bilibili"
        },
        "youtube": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "format": "uri",
          "title": "Youtube"
        }
      },
      "title": "IssueVideoLinks",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical contract for one daily AI-news issue. Single source of truth;\nevery downstream artifact (publishablePost.md/html, voiceText,\nGeneratedContent cards, RSS/JSON-Feed, video plan) is a deterministic\nprojection of this document. Text fields use ONE inline dialect: CommonMark\ninline subset — **bold**, `code`, [text](url). No block markup inside\nstrings. Spoken text (voice) is plain text, numbers already written in\nspeakable form.",
  "properties": {
    "schema": {
      "const": "issue/1",
      "default": "issue/1",
      "title": "Schema",
      "type": "string"
    },
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "weekday": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weekday"
    },
    "lang": {
      "default": "zh-CN",
      "title": "Lang",
      "type": "string"
    },
    "issue_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "format": "uri",
      "title": "Issue Url"
    },
    "video_links": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueVideoLinks"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cover": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueMedia"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "degraded": {
      "default": false,
      "description": "digest 降级标记：LLM 调用失败/部分字段兜底时置 true，下游 UI 可显式提示",
      "title": "Degraded",
      "type": "boolean"
    },
    "sections": {
      "description": "Ordered taxonomy for THIS issue. Order in array = render order. Item.section must equal one of these slugs (checked by validator, cross-field).",
      "items": {
        "$ref": "#/$defs/IssueSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "intro": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueSegment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outro": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueSegment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "items": {
      "description": "Order in array = canonical order; the #N numbering in renders is derived from position, never stored.",
      "items": {
        "$ref": "#/$defs/IssueItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "date",
    "lang",
    "sections",
    "items"
  ],
  "title": "DailyIssue",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/issue/v1"
}