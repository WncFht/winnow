{
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "raw_manifest/1",
      "default": "raw_manifest/1",
      "title": "Schema",
      "type": "string"
    },
    "episode": {
      "description": "正片 YYYY-MM-DD；_ 前缀 = 沙盒 run dir（episode 常回退 run_dir.name）",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|_.+)$",
      "title": "Episode",
      "type": "string"
    },
    "window": {
      "additionalProperties": true,
      "description": "{from,to} RFC3339 抓取窗口",
      "title": "Window",
      "type": "object"
    },
    "file": {
      "description": "本批 JSONL 文件名",
      "title": "File",
      "type": "string"
    },
    "n_items": {
      "title": "N Items",
      "type": "integer"
    },
    "sources": {
      "description": "[{name,method,tier,status,items_new,items_fresh,items_total,last_error,latency_ms,via,endpoint}] 每源统计",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Sources",
      "type": "array"
    },
    "produced_at": {
      "description": "RFC 3339 timestamp, e.g. 2026-09-21T08:30:00+08:00",
      "title": "Produced At",
      "type": "string"
    },
    "stats": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "产物体积簿记：jsonl_bytes/max_line_bytes + content_text {cap_chars,n_present,n_truncated,max_chars}（collect 填，可选）",
      "title": "Stats"
    }
  },
  "required": [
    "episode",
    "window",
    "file",
    "n_items",
    "sources",
    "produced_at"
  ],
  "title": "RawManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/raw_manifest/v1"
}