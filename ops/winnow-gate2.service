# AI 早报 pipeline — gate-2 deadline watcher (PLAN §9, D8)
# Fired by winnow-gate2.timer at 09:30 Asia/Shanghai.
# `just deadline2`: lock 50_issue.json as it stands (auto-imports a modified
# 50_review.md once), then callb -> voice -> cards -> subs -> render-plan ->
# compose -> meta.
# TEMPLATE: __REPO__ / __HOME__ are substituted by ops/install.sh at install
# time — do not copy this file into systemd/user verbatim.
# Install: bash ops/install.sh
[Unit]
Description=AI news pipeline: gate-2 deadline watcher (just deadline2)

[Service]
Type=oneshot
WorkingDirectory=__REPO__
EnvironmentFile=-__REPO__/secrets.env
# user-manager PATH lacks ~/.local/bin (uv) and ~/.cargo/bin (just)
Environment=PATH=__HOME__/.local/bin:__HOME__/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai
# downstream chain includes TTS + card render + remotion/ffmpeg compose
TimeoutStartSec=4h
ExecStart=__HOME__/.cargo/bin/just deadline2
SyslogIdentifier=winnow-gate2
