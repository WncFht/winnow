# copy to secrets.env and fill; never commit secrets.env
SWE2MAX_API_KEY=
# SWE2MAX_BG_API_KEY=    # bg-class token（devin-2api gate-classes）：设置后 pipeline 一律走 bg 通道，fg 留给交互式调用
# X_PAID_KEY=            # optional paid adapter (disabled by default)
# WEIBO_COOKIES=         # optional：微博登录 cookie——visitor mint 全失败时的保底（weibo_collect login_cookie fallback；4 个 enabled 源）
